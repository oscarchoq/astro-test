---
const brand = { name: "Nimbus" };

const navLinks = [
  { label: "Características", href: "#caracteristicas" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="navbar">
  <div class="container navbar__inner">
    <a class="brand" href="#top" aria-label={`${brand.name}, inicio`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{brand.name}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul class="nav__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary nav__cta" href="#contacto">Empieza gratis</a>
    </nav>
  </div>
</header>

<style>
  /* Desplaza el contenido para que la navbar fija no lo tape */
  :global(body) {
    padding-top: var(--navbar-h);
  }

  .navbar {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--navbar-h);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--color-border);
    z-index: 50;
  }

  .navbar__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .brand__mark {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.4rem;
    background: linear-gradient(
      135deg,
      var(--color-brand) 0%,
      #8b5cf6 100%
    );
    box-shadow: var(--shadow-sm);
  }

  .brand__name {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .nav__links a {
    font-weight: 500;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .nav__links a:hover {
    color: var(--color-brand);
  }

  /* En móvil ocultamos los enlaces de texto y dejamos marca + CTA
     para evitar desbordes horizontales a 375px. */
  @media (max-width: 640px) {
    .nav__links {
      display: none;
    }

    .nav {
      gap: 0;
    }
  }
</style>
