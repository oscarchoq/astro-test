---
const features = [
  {
    title: "Despliegue instantáneo",
    description:
      "Publica cada cambio con un solo clic. Nimbus se encarga de la infraestructura, el escalado y los rollbacks automáticos.",
    image: {
      src: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80",
      alt: "Panel con gráficas de métricas en una pantalla",
    },
  },
  {
    title: "Colaboración en tiempo real",
    description:
      "Tu equipo trabaja sobre la misma fuente de verdad, con comentarios, tareas y revisiones sincronizadas al instante.",
    image: {
      src: "https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=800&q=80",
      alt: "Dos personas revisando trabajo frente a un portátil",
    },
  },
  {
    title: "Analítica accionable",
    description:
      "Entiende cómo usan tu producto con métricas claras y alertas que te avisan antes de que algo se convierta en problema.",
    image: {
      src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80",
      alt: "Gráficas de analítica sobre un escritorio",
    },
  },
];
---

<section id="caracteristicas" class="section features">
  <div class="container">
    <div class="features__head">
      <span class="eyebrow">Características</span>
      <h2 class="features__title">Todo lo que necesitas para lanzar</h2>
      <p class="features__lead">
        Herramientas pensadas para que tu equipo avance sin fricción, desde la
        primera línea de código hasta producción.
      </p>
    </div>

    <ul class="features__grid">
      {
        features.map((feature) => (
          <li class="card">
            <img
              class="card__img"
              src={feature.image.src}
              alt={feature.image.alt}
              width={800}
              height={533}
              loading="lazy"
            />
            <div class="card__body">
              <h3 class="card__title">{feature.title}</h3>
              <p class="card__text">{feature.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    background: var(--color-surface);
  }

  .features__head {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .features__title {
    font-size: var(--text-2xl);
    margin-top: 0.75rem;
  }

  .features__lead {
    color: var(--color-muted);
    font-size: var(--text-lg);
    margin-top: 1rem;
  }

  .features__grid {
    list-style: none;
    padding: 0;
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .card__body {
    padding: 1.5rem;
  }

  .card__title {
    font-size: var(--text-xl);
  }

  .card__text {
    margin-top: 0.625rem;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .features__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
